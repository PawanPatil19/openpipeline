{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'dependencies are installed by scripts/build_site.sh'",
  "buildCommand": "bash scripts/build_site.sh",
  "outputDirectory": "build/site",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/demo/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/docs/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
